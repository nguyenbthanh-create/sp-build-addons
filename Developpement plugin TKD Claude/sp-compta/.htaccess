# Bloque l'acces direct aux fichiers de developpement / documentation / config
# qui ne doivent jamais etre servis au navigateur (uniquement presents ici
# parce que le deploiement copie le dossier local tel quel par FTP).

RewriteEngine On
RewriteRule (^|/)\.git(/|$) - [F,L]

<FilesMatch "(^readme\.txt$|^composer\.(json|lock)$|\.(md|json|xml|sql|log)$)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>
